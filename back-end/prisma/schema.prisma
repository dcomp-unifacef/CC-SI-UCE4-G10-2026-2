// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ActivityLevel {
  SEDENTARIO            // 1.200
  LIGEIRAMENTE_ATIVO    // 1.375
  MODERADAMENTE_ATIVO   // 1.550
  MUITO_ATIVO           // 1.725
  EXTREMAMENTE_ATIVO    // 1.900
}

enum BiologicalSex {
  MASCULINO
  FEMININO
}

model Patient {
  id                Int             @id @default(autoincrement())
  name              String          @db.VarChar(120)
  birthDate         DateTime        @map("birth_date") @db.Date
  gender            String          @db.VarChar(40)
  biologicalSex     BiologicalSex   @map("biological_sex")
  cpf               String          @unique
  phone             String          @db.VarChar(20)

  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  assessments       BodyAssessment[]
}

model BodyAssessment {
  id                Int             @id @default(autoincrement())
  assessmentDate    DateTime        @db.Date @map("assessment_date")
  weight            Decimal         @db.Decimal(5, 2)
  height            Decimal         @db.Decimal(3, 2)
  activityLevel     ActivityLevel   @map("activity_level")

  patientId         Int             @map("patient_id")
  patient           Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@unique([patientId, assessmentDate])
}
