# Conexão com o PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nutrisync"

# Endereços do front-end liberados pelo CORS (separados por vírgula)
ALLOWED_ORIGINS="http://localhost:5173"

# Chave usada para assinar os tokens de login (troque por um valor longo e aleatório)
JWT_SECRET="jwt-Key"