{
  "name": "back-end",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch ./src/bin/server",
    "start": "node ./dist/bin/server.js",
    "build": "rimraf dist && npx tsc",
    "postbuild": "copyfiles -u 1 src/views/*.null dist",
    "prestart": "npm run build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "chalk": "^5.6.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.4",
    "express": "^5.1.0",
    "morgan": "^1.10.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "prisma": "^7.10.0",
    "rimraf": "^6.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true
  }
}
